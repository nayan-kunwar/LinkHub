{
  "name": "linkhub",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @linkhub/web dev",
    "build": "pnpm --filter @linkhub/web build",
    "start": "pnpm --filter @linkhub/web start",
    "typecheck": "pnpm --filter @linkhub/web typecheck",
    "api:dev": "pnpm --filter @linkhub/api dev",
    "api:build": "pnpm --filter @linkhub/api build",
    "api:start": "pnpm --filter @linkhub/api start",
    "api:test": "pnpm --filter @linkhub/api test",
    "lint": "eslint apps/web packages/shared",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:setup": "pnpm db:deploy && pnpm db:seed",
    "e2e:headed": "playwright test --headed",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:all": "pnpm -r typecheck && pnpm typecheck:e2e",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "job:analytics": "tsx apps/api/src/jobs/analytics-nightly.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
