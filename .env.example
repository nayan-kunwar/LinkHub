# --- General ---
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000

# --- Database (Neon) ---
# DATABASE_URL is the pooled runtime connection; DIRECT_URL is used by migrations.
DATABASE_URL=postgresql://user:pass@host/linkhub?sslmode=require&pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://user:pass@host/linkhub?sslmode=require

# --- API ---
PORT=4000
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_MAX_AGE_DAYS=7
# Optional. Production defaults to __Host-lh.sid; test/dev defaults to lh.sid.
# SESSION_COOKIE_NAME=lh.sid
TRUST_PROXY=false
DEBUG_IP_ENDPOINT=false
WEB_INTERNAL_URL=http://localhost:3000

# --- Web ---
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep this false unless the API also has ALLOW_SIGNUP=true.
NEXT_PUBLIC_ALLOW_SIGNUP=false
# Show the "in development" banner on the home page. Set to false at launch.
NEXT_PUBLIC_DEVELOPMENT_BANNER=true
# Optional Google sign-in and sign-up. Must match the API's GOOGLE_CLIENT_ID.
# Leave both unset/empty to keep the feature hidden and disabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ALLOW_DEMO_PREVIEW=false

# --- Shared (API + Web) ---
REVALIDATE_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_FETCH_TOKEN=replace-with-at-least-32-random-bytes
WEB_PROXY_SECRET=replace-with-at-least-32-random-bytes

# --- Tenancy & features ---
DEFAULT_USERNAME=nayankunwar
ROOT_MODE=profile
ALLOW_SIGNUP=false
# Optional Google sign-in and sign-up. Leave empty to disable. The Web OAuth
# client ID ends with .apps.googleusercontent.com; no client secret is used.
# Set the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID on Vercel.
GOOGLE_CLIENT_ID=
ACCOUNT_DELETION_GRACE_DAYS=30

# --- Email ---
# console writes messages to apps/api/.mail-outbox; use resend or brevo in production.
# Production validation rejects console unless the explicit override below is true.
EMAIL_PROVIDER=console
EMAIL_FROM="Link Hub <no-reply@nayankunwar.com>"
EMAIL_RESEND_API_KEY=
EMAIL_BREVO_API_KEY=
ALLOW_CONSOLE_MAIL_IN_PRODUCTION=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# --- Analytics ---
CLICK_DEDUPE_SECONDS=30
ANALYTICS_HASH_SECRET=replace-with-at-least-32-random-bytes

# --- Link previews (Release 2.1) ---
# Server-owned OG/Twitter previews. Set false to disable all outbound fetches
# without affecting saved links or public rendering.
METADATA_FETCH_ENABLED=true
# Hosts that block server-side previews. These keep the icon fallback and do
# not consume the preview budget. A trailing `.*` matches any public suffix,
# so `amazon.*` covers amazon.com, amazon.co.uk and their subdomains.
METADATA_SKIP_HOSTS=instagram.com,instagr.am,amazon.*,amzn.*,a.co

# --- Seed ---
SEED_OWNER_EMAIL=owner@nayankunwar.com
SEED_OWNER_PASSWORD=replace-with-12-chars
SEED_OWNER_NAME=Nayan Kunwar
