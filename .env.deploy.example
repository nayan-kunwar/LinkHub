# Copy this file to .env.deploy.local (gitignored) and fill in real production
# values. Use it for `pnpm db:deploy`, `pnpm db:seed`, and local smoke tests
# against Neon. Never commit the filled-in file.

NODE_ENV=production
LOG_LEVEL=info
APP_URL=https://link.nayankunwar.com
WEB_INTERNAL_URL=https://link.nayankunwar.com

# Neon: pooled runtime URL and direct migration URL.
# `connect_timeout=120` lets Prisma fall through unreachable IPv6 routes to
# IPv4 on networks that advertise AAAA records but cannot route them (P1001).
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5&connect_timeout=120"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=120"

# Generate five distinct values:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
REVALIDATE_SECRET=
INTERNAL_FETCH_TOKEN=
WEB_PROXY_SECRET=
ANALYTICS_HASH_SECRET=

# Tenancy & features.
DEFAULT_USERNAME=nayankunwar
ROOT_MODE=landing
ALLOW_SIGNUP=false
# Optional Google sign-in and sign-up. Leave empty to keep it disabled. The
# same value must be set as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the Vercel project.
GOOGLE_CLIENT_ID=
ACCOUNT_DELETION_GRACE_DAYS=30
# Verified Render/Cloudflare hop count; re-verify if the proxy chain changes.
TRUST_PROXY=3
CLICK_DEDUPE_SECONDS=30

# Link previews (Release 2.1). Keep the kill switch true in normal operation;
# set it false to stop all outbound OG/Twitter fetches during an incident.
METADATA_FETCH_ENABLED=true
METADATA_SKIP_HOSTS=instagram.com,instagr.am,amazon.com,amazon.in,amzn.to,amzn.in,a.co

# Email. Keep console for local migrations/seed; Render uses EMAIL_PROVIDER=brevo
# with a real key.
EMAIL_PROVIDER=console
EMAIL_FROM="Link Hub <no-reply@nayankunwar.com>"
EMAIL_BREVO_API_KEY=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# One-time owner seed. Use a unique password and store it in a password manager.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME="Nayan Kunwar"
