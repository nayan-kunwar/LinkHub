// LinkHub v2.4 schema. See link-hub-architecture.md §8 for the design notes.
// The generated migration is hand-extended with citext, partial indexes and the
// sessions((sess->>'userId')) expression index. Do not add those here: Prisma
// cannot express them, and editing generated SQL is the documented path.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

enum Role {
  owner
  admin
  user
}

enum UserStatus {
  pending_verification
  active
  suspended
  deleted
}

enum Plan {
  free
}

enum TokenType {
  email_verification
  password_reset
  email_change
  account_restore
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique @db.Citext
  pendingEmail         String?       @map("pending_email") @db.Citext
  passwordHash         String?       @map("password_hash")
  role                 Role          @default(user)
  status               UserStatus    @default(pending_verification)
  plan                 Plan          @default(free)
  emailVerifiedAt      DateTime?     @map("email_verified_at") @db.Timestamptz
  deletionScheduledFor DateTime?     @map("deletion_scheduled_for") @db.Timestamptz
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz

  profile              Profile?
  accounts             Account[]
  tokens               VerificationToken[]
  categories           Category[]
  links                Link[]
  clickEvents          ClickEvent[]
  clickDailyStats      ClickDailyStat[]
  clickDailyBreakdowns ClickDailyBreakdown[]

  @@map("users")
}

// Linked external identities. The API currently supports Google sign-in for
// existing accounts only; the table still has no email or OAuth token columns.
model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @map("user_id") @db.Uuid
  provider          String
  providerAccountId String @map("provider_account_id")

  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("accounts")
}

// Mirrors connect-pg-simple's table exactly. userId lives inside sess JSON.
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  username    String   @unique @db.Citext
  displayName String   @map("display_name")
  headline    String?
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  socials     Json     @default("{}")
  theme       Json     @default("{}")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  description String?
  color       String    @default("#7c3aed")
  icon        String    @default("folder")
  isVisible   Boolean   @default(true) @map("is_visible")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links       Link[]

  @@unique([id, userId])
  @@index([userId, sortOrder])
  @@index([userId, deletedAt])
  @@map("categories")
}

model Link {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  title       String
  url         String
  type        String    @default("link")
  config      Json      @default("{}")
  description String?
  icon        String    @default("auto")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite FK: a link can only reference a category owned by the same user.
  // NoAction (not SetNull) because SET NULL on a composite FK would null user_id.
  category    Category? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  clicks           ClickEvent[]
  dailyStats       ClickDailyStat[]
  dailyBreakdowns  ClickDailyBreakdown[]

  @@unique([id, userId])
  @@index([userId, sortOrder])
  @@index([userId, categoryId])
  @@index([userId, deletedAt])
  @@map("links")
}

model ClickEvent {
  id           String   @id @default(uuid()) @db.Uuid
  linkId       String   @map("link_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  clickedAt    DateTime @default(now()) @map("clicked_at") @db.Timestamptz
  referrerHost String?  @map("referrer_host")
  deviceType   String?  @map("device_type")
  countryCode  String?  @map("country_code") @db.VarChar(2)
  visitorHash  String?  @map("visitor_hash")

  link         Link     @relation(fields: [linkId, userId], references: [id, userId], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([linkId, clickedAt])
  @@index([userId, clickedAt])
  @@index([clickedAt])
  @@map("click_events")
}

model JobState {
  name      String   @id
  watermark DateTime @db.Date
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("job_state")
}

model ClickDailyStat {
  linkId String   @map("link_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  day    DateTime @db.Date
  count  Int      @default(0)

  link   Link     @relation(fields: [linkId, userId], references: [id, userId], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([linkId, day])
  @@index([userId, day])
  @@map("click_daily_stats")
}

model ClickDailyBreakdown {
  linkId    String   @map("link_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  day       DateTime @db.Date
  dimension String
  value     String
  count     Int      @default(0)

  link      Link     @relation(fields: [linkId, userId], references: [id, userId], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([linkId, day, dimension, value])
  @@index([userId, day, dimension])
  @@map("click_daily_breakdowns")
}
